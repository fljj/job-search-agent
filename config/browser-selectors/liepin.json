{
  "platform": "LIEPIN",
  "version": "2026-08-02-v11",
  "allowed_hosts": ["c.liepin.com", "www.liepin.com"],
  "session": {
    "login_marker": "#im-c-entry",
    "verification_marker": ".geetest_panel, [class*='captcha'], [class*='verify']",
    "pending_user_input": "textarea.im-ui-textarea",
    "blocking_dialog_marker": ".ant-modal-wrap"
  },
  "job_list": {
    "job_list_root": ".job-list-box",
    "job_list_items": ".job-list-item",
    "job_list_item_id_attribute": "data-job-id",
    "job_list_item_title": "a[data-nick='job-detail-job-info'] [title^='招聘']",
    "job_list_item_company": "[data-nick='job-detail-company-info'] .ellipsis-1",
    "job_list_item_link": "a[data-nick='job-detail-job-info'][href*='/job/'], a[data-nick='job-detail-job-info'][href*='/a/']",
    "next_cursor_attribute": "data-next-cursor"
  },
  "job_detail": {
    "job_root": ".job-apply-container",
    "job_id": "[data-job-id]",
    "job_title": ".job-apply-content .job-title",
    "company": ".company-info-container .company-card .name, .recruiter-container .company-name, .recruiter-container .title-box > span:nth-child(2), .recruiter-container .title-box > a",
    "industry": ".company-intro-container .company-industry",
    "location": ".job-apply-content .job-properties > span:first-child, .job-properties .job-location",
    "work_mode": ".job-properties .work-mode",
    "salary": ".job-apply-content .salary, .job-apply-content .job-salary",
    "description": ".job-intro-container",
    "recruiter_on_job": ".recruiter-container .name",
    "recruiter_role_on_job": ".recruiter-container .title-box > span:first-child",
    "job_open_marker": ".apply-box .btn-main, .job-apply-operate .btn-chat, .recruiter-container .btn-chat",
    "job_closed_marker": ".job-status-closed, .job-detail-status-expired",
    "platform_greeting_dialog": ".im-ui-chat-modal-container",
    "platform_greeting_message": ".im-ui-message-item-send .im-ui-message-item-normal-message-wrapper"
  },
  "conversation": {
    "conversation_entry_button": "#im-c-entry .im-ui-basic-entry",
    "conversation_dialog_close_button": ".im-ui-basic-chat-modal:not(.ant-im-move-right-leave) .anticon-close",
    "conversation_drawer_close_button": ".ant-im-drawer-close",
    "conversation_list_root": ".ant-im-drawer-content-wrapper:not(.ant-im-drawer-panel-motion-right-leave) .im-ui-contact-list-wrapper",
    "conversation_list_items": ".im-ui-contact-list-item[data-tlg-ext]",
    "conversation_list_item_id_attribute": "data-tlg-ext",
    "conversation_list_item_id_json_key": "to_imid",
    "conversation_list_item_recruiter": ".im-ui-contact-title-name",
    "conversation_list_item_job_title": "[data-job-title]",
    "conversation_list_item_company": "[data-company-name]",
    "conversation_list_item_unread_attribute": "data-tlg-ext",
    "conversation_list_item_unread_selector": ".im-ui-unread-count",
    "conversation_list_item_job_id_attribute": "data-job-id",
    "conversation_list_item_last_message_id_attribute": "data-last-message-id",
    "conversation_list_item_last_message": ".im-ui-last-message",
    "conversation_list_item_last_message_time": ".contact-time",
    "conversation_list_requires_last_message_id": false,
    "conversation_list_item_category_attribute": "data-category",
    "conversation_root": ".im-ui-basic-chat-modal:not(.ant-im-move-right-leave) .im-ui-message-list-wrapper",
    "conversation_id": ".im-ui-contact-list-item.active[data-tlg-ext], .im-ui-contact-list-item.im-ui-active[data-tlg-ext]",
    "conversation_id_attribute": "data-tlg-ext",
    "conversation_id_json_key": "to_imid",
    "recruiter": ".im-ui-chat-container > div:first-child > div:first-child > div:first-child > span:first-child, .im-ui-chat-header .im-ui-contact-title-name",
    "conversation_company": ".im-ui-chat-container > div:first-child > div:nth-child(2) > div:nth-child(2) > div:first-child > span:first-child, .im-ui-chat-header .im-ui-contact-title-sub",
    "conversation_company_separator": "·",
    "conversation_job_title": ".im-ui-chat-container > div:first-child > div:nth-child(2) > div:first-child > span:first-child, .im-ui-position-title",
    "conversation_job_link": "a[href*='/job/'], a[href*='/a/']",
    "message_items": ".im-ui-message-item-body, .im-ui-message-item-wrapper[data-message-id]",
    "message_id_attribute": "data-message-id",
    "message_direction_attribute": "data-direction",
    "message_outbound_class": "im-ui-message-item-send",
    "message_time_attribute": "data-sent-at",
    "message_content": ".im-ui-message-item-normal-message-wrapper",
    "message_composer": "textarea.im-ui-textarea",
    "message_send_button": ".im-ui-basic-send-btn",
    "sent_message_items": ".im-ui-message-item-body.im-ui-message-item-send",
    "consent_cards": null,
    "consent_card_title": null,
    "consent_card_buttons": null,
    "location_consent_cards": null,
    "location_consent_title": null,
    "location_consent_detail": null,
    "location_consent_button": null
  },
  "resume_action": {
    "resume_trigger": ".im-ui-resume-trigger, .job-apply-operate .btn-minor",
    "resume_direct_confirm_button": null,
    "resume_items": ".resume-card-container",
    "resume_confirm_button": ".ant-btn-primary",
    "sent_resume_items": ".im-ui-message-item-wrapper"
  }
}
