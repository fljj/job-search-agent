{
  "platform": "BOSS",
  "version": "2026-08-02-v15",
  "allowed_hosts": [
    "www.zhipin.com",
    "m.zhipin.com"
  ],
  "session": {
    "login_marker": "[data-testid='user-avatar'], .nav-figure",
    "verification_marker": ".geetest_panel, .verify-box, [class*='captcha']"
  },
  "job_list": {
    "job_list_root": "[data-testid='job-list'], .job-list-container",
    "job_list_items": "[data-testid='job-list-item'], .job-card-box",
    "job_list_item_id_attribute": "data-job-id",
    "job_list_item_title": "[data-testid='job-title'], .job-name",
    "job_list_item_company": "[data-testid='company-name'], .boss-name",
    "job_list_item_link": "[data-testid='job-link'], .job-name",
    "next_cursor_attribute": "data-next-cursor"
  },
  "job_detail": {
    "job_root": "[data-testid='job-detail'], .job-detail",
    "job_id": "[data-job-id]",
    "job_title": "[data-testid='job-title'], .job-primary h1, h1",
    "company": "[data-testid='company-name'], .sider-company .company-info, .info-primary .brand-name, .job-detail .company-name",
    "industry": "[data-testid='company-industry'], .company-info a",
    "location": "[data-testid='job-location'], .info-primary .text-city, .job-detail .location-address",
    "work_mode": "[data-testid='work-mode'], .job-keyword-list, .job-address",
    "salary": "[data-testid='salary'], .job-primary .salary, .salary",
    "description": "[data-testid='job-description'], .job-sec-text",
    "recruiter_on_job": "[data-testid='recruiter-name'], .job-boss-info .name",
    "job_open_marker": "[data-testid='start-chat']:not([disabled]), .btn-startchat:not(.disabled)",
    "job_closed_marker": "[data-testid='job-closed'], .job-status-closed, .job-detail-status-expired",
    "platform_greeting_dialog": "[data-testid='greeting-dialog'], .startchat-content",
    "platform_greeting_message": "[data-testid='greeting-message'], .startchat-content .message-list .message-item .text"
  },
  "conversation": {
    "conversation_list_root": "[data-testid='conversation-list'], .user-list-content",
    "conversation_list_items": "[data-testid='conversation-list-item'], .user-list-content .friend-content[d-c]",
    "conversation_list_item_id_attribute": "data-conversation-id",
    "conversation_list_item_id_json_key": null,
    "conversation_list_item_recruiter": "[data-testid='recruiter-name'], .name-text",
    "conversation_list_item_job_title": "[data-testid='job-title'], .title-box span:last-child",
    "conversation_list_item_company": "[data-testid='company-name']",
    "conversation_list_item_unread_attribute": "data-unread-count",
    "conversation_list_item_unread_selector": ".badge-count, .unread-count",
    "conversation_list_item_job_id_attribute": "data-job-id",
    "conversation_list_item_last_message_id_attribute": "data-last-message-id",
    "conversation_list_item_last_message": "[data-testid='last-message'], .last-msg-text",
    "conversation_list_item_last_message_time": ".time",
    "conversation_list_requires_last_message_id": false,
    "conversation_list_item_category_attribute": "data-category",
    "conversation_root": "[data-testid='chat-panel'], .chat-conversation",
    "conversation_id": "[data-testid='chat-panel'][d-c], .chat-user .friend-content.selected",
    "conversation_id_attribute": "d-c",
    "conversation_id_json_key": null,
    "recruiter": "[data-testid='recruiter-name'], .top-info-content .name-text, .chat-name",
    "conversation_company": "[data-testid='company-name'], .chat-position-content .company-name",
    "conversation_company_separator": null,
    "conversation_job_title": "[data-testid='job-title'], .chat-position-content .position-name",
    "conversation_job_link": "[data-testid='job-link'], .chat-position-content a",
    "message_items": "[data-testid='message-item'], .chat-message .message-item",
    "message_id_attribute": "data-mid",
    "message_direction_attribute": "data-direction",
    "message_outbound_class": "item-myself",
    "message_time_attribute": "data-sent-at",
    "message_content": "[data-testid='message-content'], .message-content .text-content",
    "message_composer": "[data-testid='message-composer'], .message-controls [contenteditable='true'], textarea.chat-input",
    "message_send_button": "[data-testid='send-message'], .btn-send, .send-message",
    "sent_message_items": "[data-testid='message-item'][data-direction='outbound'], .chat-message .message-item.item-myself",
    "consent_cards": ".message-dialog-both.message-card-wrap",
    "consent_card_title": ".message-card-top-title",
    "consent_card_buttons": ".card-btn:last-child",
    "location_consent_cards": ".msg-dialog-position",
    "location_consent_title": ".msg-dialog-title",
    "location_consent_detail": ".msg-dialog-desc",
    "location_consent_button": ".msg-dialog-footer-v2 .btn-light-v2"
  },
  "resume_action": {
    "resume_trigger": "[data-testid='send-resume'], .send-resume, .toolbar-btn-content .toolbar-btn",
    "resume_direct_confirm_button": ".panel-resume .btns .btn-sure-v2",
    "resume_items": "[data-testid='resume-item'], .resume-item",
    "resume_confirm_button": "[data-testid='confirm-send-resume'], .confirm-send-resume",
    "sent_resume_items": "[data-testid='sent-resume'], .message-item.resume"
  }
}
