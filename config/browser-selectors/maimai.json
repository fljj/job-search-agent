{
  "platform": "MAIMAI",
  "version": "2026-07-29-v14",
  "allowed_hosts": [
    "maimai.cn",
    "www.maimai.cn"
  ],
  "session": {
    "login_marker": "[data-testid='user-avatar'], .user-avatar, .maimai-pc-chat-wrap",
    "verification_marker": ".verify-container, [class*='captcha']"
  },
  "job_list": {
    "job_list_root": "[data-testid='job-list']",
    "job_list_items": "[data-testid='job-list-item']",
    "job_list_item_id_attribute": "data-job-id",
    "job_list_item_title": "[data-testid='job-title']",
    "job_list_item_company": "[data-testid='company-name']",
    "job_list_item_link": "[data-testid='job-link']",
    "next_cursor_attribute": "data-next-cursor"
  },
  "job_detail": {
    "job_root": "[data-testid='job-detail'], .job-detail",
    "job_id": "[data-job-id]",
    "job_title": "[data-testid='job-title'], .job-title",
    "company": "[data-testid='company-name'], .company-name",
    "industry": "[data-testid='company-industry'], .industry",
    "location": "[data-testid='job-location'], .job-location",
    "work_mode": "[data-testid='work-mode'], .work-mode",
    "salary": "[data-testid='salary'], .salary",
    "description": "[data-testid='job-description'], .job-description",
    "recruiter_on_job": "[data-testid='recruiter-name'], .recruiter-name",
    "job_open_marker": "[data-testid='start-chat']:not([disabled]), .btn-startchat:not(.disabled)",
    "job_closed_marker": "[data-testid='job-closed'], .job-status-closed",
    "platform_greeting_dialog": "[data-testid='greeting-dialog'], .startchat-content",
    "platform_greeting_message": "[data-testid='greeting-message'], .startchat-content .message-list .message-item .text"
  },
  "conversation": {
    "conversation_list_root": "[data-testid='conversation-list'], .message-list-container, .message-list",
    "conversation_list_items": "[data-testid='conversation-list-item'], .message-item-normal[data-msg]",
    "conversation_list_item_id_attribute": "data-msg",
    "conversation_list_item_id_json_key": "mid",
    "conversation_list_item_recruiter": "[data-testid='recruiter-name'], .message-user-name",
    "conversation_list_item_job_title": "[data-testid='job-title']",
    "conversation_list_item_company": "[data-testid='company-name'], .message-user-company",
    "conversation_list_item_unread_attribute": "data-unread-count",
    "conversation_list_item_unread_selector": ".unread-count, .message-unread, .message-badge",
    "conversation_list_item_job_id_attribute": "data-job-id",
    "conversation_list_item_last_message_id_attribute": "data-last-message-id",
    "conversation_list_item_last_message": "[data-testid='last-message'], .message-latest-text",
    "conversation_list_item_last_message_time": null,
    "conversation_list_requires_last_message_id": true,
    "conversation_list_item_category_attribute": "data-category",
    "conversation_root": "[data-testid='chat-panel'], .dialogue_list_container, .chat-panel",
    "conversation_id": "[data-testid='chat-panel'][data-msg], .message-item.selected[data-msg], .message-item.active[data-msg], .message-item[data-msg][aria-selected='true']",
    "conversation_id_attribute": "data-msg",
    "conversation_id_json_key": "mid",
    "recruiter": "[data-testid='recruiter-name'], .dialogue-header-username, .recruiter-name",
    "conversation_company": "[data-testid='company-name'], .dialogue-header-career, .company-name",
    "conversation_company_separator": "·",
    "conversation_job_title": "[data-testid='job-title'], .chat-position-content .position-name",
    "conversation_job_link": "[data-testid='job-link'], .chat-position-content a",
    "message_items": "[data-testid='message-item'], .dialogue_list_container .message-record, .dialogue_list_container .generic-card-wrapper",
    "message_id_attribute": "data-message-id",
    "message_direction_attribute": "data-direction",
    "message_outbound_class": "outbound",
    "message_time_attribute": "data-sent-at",
    "message_content": "[data-testid='message-content'], .message-content, .dialogue-text, .generic-card-center-content",
    "message_composer": "[data-testid='message-composer'], textarea.chat-input",
    "message_send_button": "[data-testid='send-message'], .send-message",
    "sent_message_items": "[data-testid='message-item'][data-direction='outbound'], .message-item.outbound",
    "consent_cards": null,
    "consent_card_title": null,
    "consent_card_buttons": null,
    "location_consent_cards": null,
    "location_consent_title": null,
    "location_consent_detail": null,
    "location_consent_button": null
  },
  "resume_action": {
    "resume_trigger": "[data-testid='send-resume'], .send-resume",
    "resume_direct_confirm_button": null,
    "resume_items": "[data-testid='resume-item'], .resume-item",
    "resume_confirm_button": "[data-testid='confirm-send-resume'], .confirm-send-resume",
    "sent_resume_items": "[data-testid='sent-resume'], .message-item.resume"
  }
}
