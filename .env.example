DATABASE_URL=postgresql+psycopg://job_agent:job_agent@localhost:55432/job_agent
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LLM_PROVIDERS=ZHIPU,QWEN
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.2
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
AGENT_LEASE_SECONDS=30
AGENT_TICK_BATCH_SIZE=10
BOSS_JOB_BATCH_SIZE=5
BOSS_JOB_SCAN_INTERVAL_SECONDS=180
LIEPIN_JOB_BATCH_SIZE=1
LIEPIN_JOB_SCAN_INTERVAL_SECONDS=180
LIEPIN_JOB_SEARCH_LABELS=Golang,Java
LIEPIN_WRITES_ENABLED=true
BOSS_LLM_RETRY_BASE_SECONDS=300
BOSS_LLM_RETRY_MAX_SECONDS=3600
BOSS_JOB_RETRY_MAX_ATTEMPTS=5
AGENT_FAILURE_THRESHOLD=3
AGENT_POLL_INTERVAL_SECONDS=10
AGENT_EXECUTOR_MODE=REAL
AGENT_CDP_URL=http://127.0.0.1:9222
BOSS_JOB_SEARCH_LABELS=推荐,Java,区块链工程师
CALENDAR_PROVIDER=APPLE
APPLE_CALENDAR_NAME=求职面试
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEOUT_SECONDS=10
WORKER_STALE_SECONDS=60
RECONCILIATION_TIMEOUT_MINUTES=60
RECONCILIATION_BATCH_SIZE=10
AUDIT_RETENTION_DAYS=365
RUN_EVENT_RETENTION_DAYS=90
AGENT_LOG_DIR=~/Desktop/job-search-agent/logs
AGENT_LOG_MAX_BYTES=20000000
AGENT_LOG_BACKUP_COUNT=14
# API 默认只监听本机；非本机监听必须同时设置 API_ACCESS_TOKEN。
API_HOST=127.0.0.1
API_ACCESS_TOKEN=
